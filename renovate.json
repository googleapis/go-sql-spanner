{
  "extends": [
    "config:base",
    "schedule:daily",
    "docker:disable"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  "semanticCommitScope": "",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "commitMessageAction": "update",
  "groupName": "all dependencies",
  "ignoreDeps": [
    "Alpha.Google.Cloud.SpannerLib.GrpcServer",
    "Alpha.Google.Cloud.SpannerLib.Native",
    "java-jdk"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7.0.0"
    }
  ]
}
