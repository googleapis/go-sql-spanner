# frozen_string_literal: true

source "https://rubygems.org"

gemspec

gem "rake", "~> 13.0"

# TODO(https://github.com/grpc/grpc/issues/43374): Remove once grpc publishes an x64-mingw-ucrt gem for >= 1.85.0.
# grpc 1.85.0 was published without a precompiled x64-mingw-ucrt binary gem, causing Windows Bundler to
# fall back to the source gem and fail linking against -lx64-ucrt-ruby.
gem "grpc", "< 1.85.0"

group :development, :test do
  gem "minitest", "~> 6.0"
  gem "rake-compiler", "~> 1.0"
  gem "rspec", "~> 3.0"
  gem "rubocop", require: false
  gem "rubocop-rspec", require: false
end
